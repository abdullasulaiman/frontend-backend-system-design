---
import { getCollection } from 'astro:content';
import { buildNav, flattenNav } from '../lib/navigation';
import { COURSES, type Course } from '../lib/courses';
import ProgressRing from './ProgressRing';

export interface Props {
  /** Key of the course currently being viewed (see src/lib/courses.ts). */
  activeCourse: Course['key'];
  /** id (slug) of the lesson currently being viewed, if any, for highlighting. */
  activeId?: string;
}

const { activeCourse, activeId } = Astro.props;

const course = COURSES.find(c => c.key === activeCourse) ?? COURSES[0];

// Resolve each course's first lesson (from its first track) once, for the
// course switcher at the top of the sidebar. Falls back to `/cheatsheets`
// if a course has no lessons yet, so the switcher link is never dead.
const courseFirstHrefs = new Map<Course['key'], string>();
for (const c of COURSES) {
  let href = '/cheatsheets';
  for (const track of c.tracks) {
    const entries = await getCollection(track.collection);
    const first = flattenNav(buildNav(entries))[0];
    if (first) {
      href = `${track.basePath}/${first.id}`;
      break;
    }
  }
  courseFirstHrefs.set(c.key, href);
}

// `buildNav` groups by module, and modules are scoped per-track, so each
// track's entries are grouped independently rather than merged together.
const tracks = await Promise.all(
  course.tracks.map(async track => {
    const entries = await getCollection(track.collection);
    return { ...track, nav: buildNav(entries) };
  })
);

// Build each module's lesson-id list once here (stable reference) and pass
// that same array down to <ProgressRing>. ProgressRing's effect depends on
// `lessonIds`, so a freshly-allocated array literal on every render would
// make it tear down + re-subscribe its `gfsd:progress` listener needlessly.
const moduleLessonIds = new Map<string, string[]>();
for (const track of tracks) {
  for (const mod of track.nav) {
    moduleLessonIds.set(`${track.key}:${mod.module}`, mod.lessons.map(l => l.id));
  }
}
---

<aside
  class="w-full shrink-0 border-[var(--border)] p-4 lg:sticky lg:top-16 lg:h-[calc(100vh-4rem)] lg:w-72 lg:overflow-y-auto lg:border-r"
  aria-label="Lesson navigation"
  transition:persist={`sidebar-${course.key}`}
>
  <nav aria-label="Courses" class="mb-5 flex flex-col gap-1 border-b border-[var(--border)] pb-4">
    <h2 class="mb-1 px-2 text-xs font-bold uppercase tracking-wide text-[var(--muted)]">Courses</h2>
    {COURSES.map(c => {
      const isActiveCourse = c.key === course.key;
      return (
        <a
          href={courseFirstHrefs.get(c.key)}
          aria-current={isActiveCourse ? 'page' : undefined}
          class="course-switch-link rounded-sm px-2 py-1.5 text-sm font-medium text-[var(--muted)] no-underline transition-colors duration-[var(--transition-fast)] hover:bg-[var(--surface)] hover:text-[var(--text)]"
        >
          {c.label}
        </a>
      );
    })}
  </nav>

  {tracks.map(track => (
    <div class="mb-6 last:mb-0">
      <h2 class="mb-2 px-2 text-xs font-bold uppercase tracking-wide text-[var(--muted)]">
        {track.label}
      </h2>

      {track.nav.length === 0 && (
        <p class="px-2 text-sm text-[var(--muted)]">Lessons coming soon.</p>
      )}

      {track.nav.map(mod => {
        const lessonIds = moduleLessonIds.get(`${track.key}:${mod.module}`) ?? [];
        return (
          <div class="mb-4 last:mb-0">
            <div class="flex items-center justify-between gap-2 px-2 py-1">
              <span class="text-sm font-semibold text-[var(--text)]">{mod.module}</span>
              <ProgressRing client:visible lessonIds={lessonIds} size={28} />
            </div>
            <ul class="flex flex-col gap-0.5">
              {mod.lessons.map(lesson => {
                const isActive = lesson.id === activeId;
                return (
                  <li>
                    <a
                      href={`${track.basePath}/${lesson.id}`}
                      aria-current={isActive ? 'page' : undefined}
                      class="nav-lesson block rounded-sm px-2 py-1.5 text-sm transition-colors duration-[var(--transition-fast)]"
                    >
                      {lesson.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })}
    </div>
  ))}
</aside>

<script is:inline>
  // The sidebar is `transition:persist`ed across view-transition navigations,
  // so its server-rendered active highlight would go stale. Reconcile the
  // `aria-current="page"` marker against the current URL on every page load
  // (fires on first load AND after each view transition). CSS keys the active
  // styling off `[aria-current="page"]`, so toggling the attribute is enough.
  (function () {
    function syncActiveLesson() {
      var here = location.pathname.replace(/\/+$/, '');
      document.querySelectorAll('a.nav-lesson').forEach(function (a) {
        var href = a.getAttribute('href') || '';
        if (href.replace(/\/+$/, '') === here) {
          a.setAttribute('aria-current', 'page');
        } else {
          a.removeAttribute('aria-current');
        }
      });
    }
    syncActiveLesson();
    document.addEventListener('astro:page-load', syncActiveLesson);
  })();
</script>
