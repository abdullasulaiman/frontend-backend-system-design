---
import Search from './Search.astro';
import ThemeToggle from './ThemeToggle';
import { getCollection } from 'astro:content';
import { buildNav, flattenNav } from '../lib/navigation';

// Resolve the first lesson of each track so the nav never points at a
// bare `/concepts` or `/interview` route, neither of which exists (only
// the dynamic `/concepts/[...slug]` and `/interview/[...slug]` pages do).
// Falls back to `/cheatsheets` if a track has no lessons yet, so the link
// is never dead even while content is sparse.
const [conceptEntries, interviewEntries] = await Promise.all([
  getCollection('concepts'),
  getCollection('interview'),
]);
const firstConceptLesson = flattenNav(buildNav(conceptEntries))[0];
const firstInterviewLesson = flattenNav(buildNav(interviewEntries))[0];
const conceptsHref = firstConceptLesson ? `/concepts/${firstConceptLesson.id}` : '/cheatsheets';
const interviewHref = firstInterviewLesson ? `/interview/${firstInterviewLesson.id}` : '/cheatsheets';
---

<header class="sticky top-0 z-40 border-b border-[var(--border)] bg-[var(--bg)]/95 backdrop-blur supports-[backdrop-filter]:bg-[var(--bg)]/80">
  <div class="mx-auto flex max-w-[1600px] items-center gap-4 px-4 py-3 sm:px-6">
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 text-base font-bold text-[var(--text)] no-underline"
    >
      <span
        aria-hidden="true"
        class="inline-flex h-8 w-8 items-center justify-center rounded-card bg-[var(--brand)] text-sm font-bold text-white"
      >
        GF
      </span>
      <span class="hidden sm:inline">Grokking Frontend System Design</span>
    </a>

    <nav class="hidden items-center gap-4 text-sm font-medium md:flex" aria-label="Tracks">
      <a href={conceptsHref} class="text-[var(--muted)] transition-colors duration-[var(--transition-fast)] hover:text-[var(--text)]">
        Concepts
      </a>
      <a href={interviewHref} class="text-[var(--muted)] transition-colors duration-[var(--transition-fast)] hover:text-[var(--text)]">
        Interview Prep
      </a>
    </nav>

    <div class="ml-auto flex items-center gap-3">
      <Search />
      <ThemeToggle client:load />
    </div>
  </div>
</header>
