---
import Search from './Search.astro';
import ThemeToggle from './ThemeToggle';
import { getCollection } from 'astro:content';
import { buildNav, flattenNav } from '../lib/navigation';
import { COURSES } from '../lib/courses';

// Resolve the first lesson of each COURSE (from its first track) so the nav
// never points at a bare course route, none of which exist (only the
// dynamic `[...slug]` pages per track do). Falls back to `/cheatsheets` if
// a course has no lessons yet, so the link is never dead even while content
// is sparse.
async function firstLessonHref(course: (typeof COURSES)[number]): Promise<string> {
  for (const track of course.tracks) {
    const entries = await getCollection(track.collection);
    const first = flattenNav(buildNav(entries))[0];
    if (first) return `${track.basePath}/${first.id}`;
  }
  return '/cheatsheets';
}

// Short labels for the top-level nav — the full course.label ("Frontend
// System Design", "System Design Interview") is used elsewhere (landing
// page, sidebar course switcher) but is too long for the header.
const shortLabels: Record<(typeof COURSES)[number]['key'], string> = {
  frontend: 'Frontend',
  'system-design': 'System Design',
};

const courseHrefs = await Promise.all(COURSES.map(firstLessonHref));
const courseLinks = COURSES.map((course, i) => ({
  course,
  href: courseHrefs[i],
  label: shortLabels[course.key],
}));
---

<header
  class="sticky top-0 z-40 border-b border-[var(--border)] bg-[var(--bg)]/95 backdrop-blur supports-[backdrop-filter]:bg-[var(--bg)]/80"
  transition:persist
>
  <div class="mx-auto flex max-w-[1600px] items-center gap-4 px-4 py-3 sm:px-6">
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 text-base font-bold text-[var(--text)] no-underline"
    >
      <span
        aria-hidden="true"
        class="inline-flex h-8 w-8 items-center justify-center rounded-card bg-[var(--brand)] text-sm font-bold text-white"
      >
        SD
      </span>
      <span class="hidden sm:inline">The System Design Handbook</span>
    </a>

    <nav class="hidden items-center gap-4 text-sm font-medium md:flex" aria-label="Courses">
      {courseLinks.map(({ href, label }) => (
        <a href={href} class="text-[var(--muted)] transition-colors duration-[var(--transition-fast)] hover:text-[var(--text)]">
          {label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-3">
      <Search />
      <ThemeToggle client:load />
    </div>
  </div>
</header>
